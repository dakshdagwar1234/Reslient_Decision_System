# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/resilient_decision_system

# Simulated External Dependency Chaos Settings
# Probability of simulated failure (0.0 = 0%, 1.0 = 100%)
SIMULATE_TIMEOUT_RATE=0.10
SIMULATE_5XX_RATE=0.10
EXTERNAL_LATENCY_MS=300
CIRCUIT_BREAKER_TIMEOUT_MS=3000

# Retry Configuration
MAX_RETRIES=3
RETRY_BASE_BACKOFF_MS=1000
RETRY_POLL_INTERVAL_MS=5000

# Client Configuration
CLIENT_ORIGIN=http://localhost:5173

